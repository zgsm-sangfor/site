{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/fetch-blog-data.js",
    "prebuild": "node scripts/fetch-blog-data.js",
    "dev": "vite --host",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "dev:leads": "node server/index.mjs",
    "test:leads": "node --test server/enterpriseLead.test.mjs",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "test": "echo 'Testing framework not yet configured. Please run: pnpm add -D vitest @vue/test-utils happy-dom'",
    "test:unit": "echo 'Testing framework not yet configured.'"
  },
  "dependencies": {
    "@unhead/vue": "^2.1.12",
    "tailwindcss": "^4.1.10",
    "three": "^0.185.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "@tsconfig/node22": "^22.0.1",
    "@types/node": "^22.14.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.22.0",
    "eslint-plugin-vue": "~10.0.0",
    "gray-matter": "^4.0.3",
    "happy-dom": "^20.7.0",
    "less": "^4.3.0",
    "naive-ui": "^2.41.0",
    "npm-run-all2": "^7.0.2",
    "prettier": "3.5.3",
    "typescript": "~5.8.0",
    "vite": "^7.3.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vitest": "^4.0.18",
    "vue-i18n": "11.2.2",
    "vue-tsc": "^2.2.8"
  }
}
