# Without an override, the API defaults to https://api.costrict.ai.
# Copy this file to .env.local for local debugging, then restart Vite.
# Explicitly empty: same-origin, using Vite proxy to localhost:8080 in development.
# For cross-origin local testing: VITE_API_BASE_URL=http://127.0.0.1:8080
# Production default: VITE_API_BASE_URL=https://api.costrict.ai
# This is a PUBLIC build-time value. Never put Turnstile Secret Key here.
# .env.local
VITE_API_BASE_URL=
